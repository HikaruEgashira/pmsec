{
  "setup": {
    ".config/composer/config.json": "{\n  \"config\": {\n    \"policy\": {\n      \"cooldown\": {\n        \"period\": 172800\n      }\n    },\n    \"allow-plugins\": false,\n    \"secure-http\": true,\n    \"disable-tls\": false,\n    \"audit\": {\n      \"abandoned\": \"fail\"\n    }\n  }\n}\n"
  },
  "args": ["--tool", "composer", "--check", "--json", "--days", "2"],
  "expected_exit": 0,
  "expected_json": {
    "bundleDays": 2,
    "rows": [
      {
        "tool": "composer", "key": "policy.cooldown.period", "path": "<HOME>/.config/composer/config.json",
        "configured": "172800", "days": 2, "warn": null,
        "extras": [
          {"key": "allow-plugins", "configured": "false", "expected": "false", "ok": true},
          {"key": "secure-http", "configured": "true", "expected": "true", "ok": true},
          {"key": "disable-tls", "configured": "false", "expected": "false", "ok": true},
          {"key": "abandoned", "configured": "\"fail\"", "expected": "\"fail\"", "ok": true}
        ]
      }
    ],
    "ok": true
  }
}
