{
  "setup": {
    ".config/composer/config.json": "{\n  \"config\": {\n    \"minimum_release_age\": \"2 weeks\",\n    \"allow-plugins\": false,\n    \"secure-http\": true,\n    \"disable-tls\": false,\n    \"audit\": {\n      \"abandoned\": \"fail\"\n    }\n  }\n}\n"
  },
  "args": ["--tool", "composer", "--check", "--json", "--days", "14"],
  "expected_exit": 0,
  "expected_json": {
    "bundleDays": 14,
    "rows": [
      {
        "tool": "composer", "key": "minimum-release-age", "path": "<HOME>/.config/composer/config.json",
        "configured": "\"2 weeks\"", "days": 14, "warn": null,
        "extras": [
          {"key": "allow-plugins", "configured": "false", "expected": "false", "ok": true},
          {"key": "secure-http", "configured": "true", "expected": "true", "ok": true},
          {"key": "disable-tls", "configured": "false", "expected": "false", "ok": true},
          {"key": "abandoned", "configured": "\"fail\"", "expected": "\"fail\"", "ok": true}
        ]
      }
    ],
    "ok": true
  }
}
