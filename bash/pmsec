    npm)
      printf 'audit-level|high|audit-level=high|=|\n'
      printf 'allow-git|root|allow-git=root|=||none,root\n'
      printf 'allow-remote|root|allow-remote=root|=||none,root\n'
      printf 'allow-file|root|allow-file=root|=||none,root\n'
      printf 'allow-directory|root|allow-directory=root|=||none,root\n'
      printf 'strict-allow-scripts|true|strict-allow-scripts=true|=|\n'
      printf 'dangerously-allow-all-scripts|false|dangerously-allow-all-scripts=false|=|\n'
      printf 'allow-scripts-pin|true|allow-scripts-pin=true|=|\n'
      printf 'ignore-extension|true|ignore-extension=true|=|\n'
      ;;
    pnpm)
      printf 'trust-policy|no-downgrade|trust-policy=no-downgrade|=|\n'
      printf 'block-exotic-subdeps|true|block-exotic-subdeps=true|=|\n'
      printf 'strict-dep-builds|true|strict-dep-builds=true|=|\n'
      printf 'verify-deps-before-run|error|verify-deps-before-run=error|=|\n'
      printf 'minimum-release-age-strict|true|minimum-release-age-strict=true|=|\n'
      printf 'dangerously-allow-all-builds|false|dangerously-allow-all-builds=false|=|\n'
      printf 'trust-lockfile|false|trust-lockfile=false|=|\n'
      printf 'minimum-release-age-ignore-missing-time|false|minimum-release-age-ignore-missing-time=false|=|\n'
      ;;
    yarn)
      printf 'enableHardenedMode|true|enableHardenedMode: true|:|\n'
      printf 'enableScripts|false|enableScripts: false|:|\n'
      printf 'approvedGitRepositories|[]|approvedGitRepositories: []|:|\n'
      ;;
    bun)
      printf 'ignoreScripts|true|ignoreScripts = true|=|install\n'
      ;;
    uv)
      printf 'index-strategy|"first-index"|index-strategy = "first-index"|=|\n'
      printf 'malware-check|true|malware-check = true|=|audit\n'
      ;;
    mise)
      printf 'paranoid|true|paranoid = true|=|settings\n'
      printf 'gpg_verify|true|gpg_verify = true|=|settings\n'
      printf 'github_attestations|true|github_attestations = true|=|settings\n'
      printf 'slsa|true|slsa = true|=|settings\n'
      printf 'locked_verify_provenance|true|locked_verify_provenance = true|=|settings\n'
      printf 'ruby.github_attestations|true|ruby.github_attestations = true|=|settings\n'
      printf 'python.github_attestations|true|python.github_attestations = true|=|settings\n'
      printf 'provenance_api_failures_fatal|true|provenance_api_failures_fatal = true|=|settings\n'
      printf 'aqua.github_attestations|true|aqua.github_attestations = true|=|settings\n'
      printf 'aqua.cosign|true|aqua.cosign = true|=|settings\n'
      printf 'aqua.minisign|true|aqua.minisign = true|=|settings\n'
      printf 'aqua.slsa|true|aqua.slsa = true|=|settings\n'
      printf 'github.github_attestations|true|github.github_attestations = true|=|settings\n'
      printf 'github.slsa|true|github.slsa = true|=|settings\n'
      printf 'node.gpg_verify|true|node.gpg_verify = true|=|settings\n'
      printf 'swift.gpg_verify|true|swift.gpg_verify = true|=|settings\n'
      printf 'not_found_system_fallback|false|not_found_system_fallback = false|=|settings\n'
      ;;
