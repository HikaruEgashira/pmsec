# Per-tool hardening extras: emit one extra per line, pipe-delimited as
# key|expected|full-line|sep|section|safe-values. Pipe (not tab) so adjacent
# empty fields survive `read` (whitespace IFS collapses runs of separators).
tool_extras() {
